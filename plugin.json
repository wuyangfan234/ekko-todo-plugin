  "server": "dist/server.mjs",
  "client": "dist/client.mjs",
  "permissions": [
    "ui",
    "api.read",
    "api.write",
    "tools",
    "events",
    "automation"
  ],
  "mcp": {
    "name": "ekko-todo"
  },
  "configSchema": {
    "type": "object",
    "description": "Global Ekko ToDo runtime defaults.",
    "properties": {
      "maxConcurrentBuilds": {
        "type": "integer",
        "description": "Maximum concurrent isolated worktree builds per host.",
        "default": 2,
        "minimum": 1,
        "maximum": 8
      },
      "reconcileIntervalMs": {
        "type": "integer",
        "description": "Background reconciliation poll interval in milliseconds.",
        "default": 6000,
        "minimum": 2000,
        "maximum": 60000
      },
      "testGateTimeoutMs": {
        "type": "integer",
        "description": "Maximum runtime for deterministic pre-gate test commands in milliseconds.",
        "default": 180000,
        "minimum": 5000,
        "maximum": 600000
      }
    },
    "additionalProperties": false
  },
  "views": [
    {
      "id": "chief",
      "title": "Ekko ToDo",
      "slot": "page",
      "icon": "assets/logo.png",
      "order": 10
